{
  "name": "findcrypt",
  "version": "0.2.0",
  "description": "Find cryptographic fingerprints in any file: AES S-boxes, SHA initial values, ChaCha sigma constants and more — with entropy analysis, string extraction and analyst verdicts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "findcrypt": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fixtures:check": "node scripts/gen-fixtures.mjs --check",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run build && vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kn1ght073/findcrypt.git"
  },
  "homepage": "https://github.com/kn1ght073/findcrypt#readme",
  "bugs": {
    "url": "https://github.com/kn1ght073/findcrypt/issues"
  },
  "author": "kn1ght073",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "crypto",
    "cryptography",
    "reverse-engineering",
    "malware-analysis",
    "binary-analysis",
    "entropy",
    "ctf",
    "security",
    "forensics",
    "findcrypt",
    "aes",
    "sha256",
    "chacha20"
  ],
  "license": "MIT"
}
